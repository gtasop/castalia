// Castalia data model. All money is stored as integer euro cents.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LISTENER
  ARTIST
  ADMIN
}

enum Theme {
  SYSTEM // follow the device's light/dark setting
  LIGHT
  DARK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(LISTENER)
  theme        Theme    @default(SYSTEM)
  createdAt    DateTime @default(now())

  sessions     Session[]
  artist       Artist?
  subscription Subscription?
  payments     SubscriptionPayment[]
  purchases    Purchase[]
  plays        Play[]
  donations    Donation[]
  allocations  Allocation[]
}

model Session {
  id        String   @id // random token stored in an httpOnly cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Artist {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  bio             String   @default("")
  stripeAccountId String?
  payoutsEnabled  Boolean  @default(false)
  createdAt       DateTime @default(now())

  albums      Album[]
  plays       Play[]
  earnings    ArtistEarning[]
  allocations Allocation[]
}

model Album {
  id          String    @id @default(cuid())
  artistId    String
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  priceCents  Int       // set by the artist, VAT included
  coverKey    String?
  published   Boolean   @default(false)
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  // Optional, up to 3, from the fixed list in src/lib/genres.ts.
  genres      String[]  @default([])

  // 15-second preview chosen by the artist. Without a choice the preview
  // comes from the first track. The clip is generated on first request and
  // cached; the fingerprint says which track/start/file it was cut from.
  previewTrackId     String?
  previewStartSec    Int     @default(0)
  previewKey         String?
  previewFingerprint String?

  tracks    Track[]
  purchases Purchase[]
  zips      AlbumZip[]

  @@index([artistId])
  @@index([genres], type: Gin)
}

// A cached download zip of an album in one format, built the first time a
// buyer asks for it so later downloads are served straight from storage.
// The fingerprint covers everything that ends up in the zip, so any change
// to the album (titles, tracks, files) makes it stale and it is rebuilt.
model AlbumZip {
  id          String   @id @default(cuid())
  albumId     String
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  format      String   // "hires" | "flac" | "mp3"
  fingerprint String
  key         String
  bytes       BigInt
  createdAt   DateTime @default(now())

  @@unique([albumId, format])
}

enum TrackStatus {
  PROCESSING
  READY
  FAILED
}

model Track {
  id               String      @id @default(cuid())
  albumId          String
  album            Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  number           Int
  title            String
  durationSec      Float       @default(0)
  status           TrackStatus @default(PROCESSING)
  error            String?
  masterBitDepth   Int?
  masterSampleRate Int?
  // The uploaded master is only kept when none of the FLAC files below
  // decodes to exactly the same audio (e.g. 16-bit/48 kHz or 32-bit float).
  masterKey        String?
  createdAt        DateTime    @default(now())

  files TrackFile[]
  plays Play[]

  @@index([albumId])
}

enum Quality {
  HIRES    // FLAC, original resolution up to 24-bit/192kHz
  LOSSLESS // FLAC 16-bit/44.1kHz
  LOW      // AAC 256kbps, data saver
  MP3      // MP3 320kbps, download only
}

model TrackFile {
  id         String  @id @default(cuid())
  trackId    String
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  quality    Quality
  key        String  // storage key
  mime       String
  bytes      Int
  bitDepth   Int?
  sampleRate Int?

  @@unique([trackId, quality])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents          Int                // pay-what-you-want, minimum enforced in code
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())

  payments SubscriptionPayment[]
}

// One paid month of a subscription. Its money is allocated once the
// period is over, based on what the subscriber listened to in it.
model SubscriptionPayment {
  id              String       @id @default(cuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  grossCents      Int
  taxCents        Int
  feeCents        Int
  netCents        Int          // gross - tax - fee
  stripeInvoiceId String?      @unique
  paidAt          DateTime     @default(now())
  payoutRunId     String?
  payoutRun       PayoutRun?   @relation(fields: [payoutRunId], references: [id])

  allocations Allocation[]

  @@index([periodEnd])
}

model Purchase {
  id              String     @id @default(cuid())
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumId         String
  album           Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  grossCents      Int
  taxCents        Int
  feeCents        Int
  netCents        Int
  stripeSessionId String?    @unique
  createdAt       DateTime   @default(now())
  payoutRunId     String?
  payoutRun       PayoutRun? @relation(fields: [payoutRunId], references: [id])

  @@unique([userId, albumId])
}

// Only plays of 30 seconds or more are stored.
model Play {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
  @@index([playedAt])
}

model HostingCost {
  id          String   @id @default(cuid())
  month       String   @unique // "2026-10"
  amountCents Int
  note        String   @default("")
  createdAt   DateTime @default(now())
}

model Donation {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  grossCents      Int
  feeCents        Int
  netCents        Int
  stripeSessionId String?  @unique
  createdAt       DateTime @default(now())
}

enum ReserveKind {
  DONATION
  HOSTING_SHORTFALL
}

// Ledger of the donation reserve that covers hosting above the 20% cap.
model ReserveEntry {
  id          String      @id @default(cuid())
  kind        ReserveKind
  amountCents Int         // positive = in, negative = out
  note        String      @default("")
  payoutRunId String?
  createdAt   DateTime    @default(now())
}

enum PayoutRunStatus {
  FINALIZED
  PAID
}

model PayoutRun {
  id                 String          @id @default(cuid())
  month              String          @unique // payments whose period ended in this month
  status             PayoutRunStatus @default(FINALIZED)
  hostingCostCents   Int
  hostingCoveredCents Int            // taken from subscriptions
  reserveDrawCents   Int             // taken from the donation reserve
  createdAt          DateTime        @default(now())

  payments    SubscriptionPayment[]
  purchases   Purchase[]
  allocations Allocation[]
  earnings    ArtistEarning[]
}

enum AllocationKind {
  HOSTING
  ARTIST_PLAYS
  SHARED_FUND
}

// Where each subscription payment's net money went. Powers the
// subscriber's "where my money went" statement.
model Allocation {
  id          String         @id @default(cuid())
  payoutRunId String
  payoutRun   PayoutRun      @relation(fields: [payoutRunId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     SubscriptionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        AllocationKind
  artistId    String?
  artist      Artist?        @relation(fields: [artistId], references: [id], onDelete: Cascade)
  plays       Int            @default(0)
  amountCents Int

  @@index([userId])
}

model ArtistEarning {
  id                String    @id @default(cuid())
  payoutRunId       String
  payoutRun         PayoutRun @relation(fields: [payoutRunId], references: [id], onDelete: Cascade)
  artistId          String
  artist            Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  subscriptionCents Int
  sharedFundCents   Int
  salesCents        Int
  totalCents        Int
  stripeTransferId  String?
  paidAt            DateTime?

  @@unique([payoutRunId, artistId])
}
