// Castalia data model. All money is stored as integer euro cents.
//
// Castalia never holds money: an album is bought straight from the artist
// (a Stripe "direct charge" on the artist's own account), and the running
// costs are covered by donations through an external fiscal host.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  LISTENER
  ARTIST
  ADMIN
}

enum Theme {
  SYSTEM // follow the device's light/dark setting
  LIGHT
  DARK
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  // Null for accounts that only sign in with Google.
  passwordHash String?
  // Google's stable account id ("sub"), once Google sign-in is connected.
  googleId     String?  @unique
  role         Role     @default(LISTENER)
  theme        Theme    @default(SYSTEM)
  createdAt    DateTime @default(now())

  sessions  Session[]
  artist    Artist?
  purchases Purchase[]
  plays     Play[]
}

model Session {
  id        String   @id // random token stored in an httpOnly cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([userId])
}

model Artist {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  bio             String   @default("")
  // The artist's own Stripe account; buyers pay into it directly.
  stripeAccountId String?
  paymentsEnabled Boolean  @default(false)
  createdAt       DateTime @default(now())

  albums Album[]
  plays  Play[]
}

model Album {
  id          String    @id @default(cuid())
  artistId    String
  artist      Artist    @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title       String
  description String    @default("")
  priceCents  Int       // set by the artist, VAT included
  coverKey    String?
  published   Boolean   @default(false)
  releasedAt  DateTime?
  createdAt   DateTime  @default(now())
  // Optional, up to 3, from the fixed list in src/lib/genres.ts.
  genres      String[]  @default([])
  // Title and artist name, lowercased with accents removed, for search.
  // Kept in sync by src/lib/search.ts whenever either changes.
  searchText  String    @default("")

  // 15-second preview chosen by the artist. Without a choice the preview
  // comes from the first track. The clip is generated on first request and
  // cached; the fingerprint says which track/start/file it was cut from.
  previewTrackId     String?
  previewStartSec    Int     @default(0)
  previewKey         String?
  previewFingerprint String?

  tracks    Track[]
  purchases Purchase[]
  zips      AlbumZip[]

  @@index([artistId])
  @@index([genres], type: Gin)
}

// A cached download zip of an album in one format, built the first time a
// buyer asks for it so later downloads are served straight from storage.
// The fingerprint covers everything that ends up in the zip, so any change
// to the album (titles, tracks, files) makes it stale and it is rebuilt.
model AlbumZip {
  id          String   @id @default(cuid())
  albumId     String
  album       Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  format      String   // "hires" | "flac" | "mp3"
  fingerprint String
  key         String
  bytes       BigInt
  createdAt   DateTime @default(now())

  @@unique([albumId, format])
}

enum TrackStatus {
  PROCESSING
  READY
  FAILED
}

model Track {
  id               String      @id @default(cuid())
  albumId          String
  album            Album       @relation(fields: [albumId], references: [id], onDelete: Cascade)
  number           Int
  title            String
  durationSec      Float       @default(0)
  status           TrackStatus @default(PROCESSING)
  error            String?
  masterBitDepth   Int?
  masterSampleRate Int?
  // The uploaded master is only kept when none of the FLAC files below
  // decodes to exactly the same audio (e.g. 16-bit/48 kHz or 32-bit float).
  masterKey        String?
  // Open tracks can be streamed in full by anyone; the rest need the album.
  open             Boolean     @default(false)
  createdAt        DateTime    @default(now())

  files TrackFile[]
  plays Play[]

  @@index([albumId])
}

enum Quality {
  HIRES    // FLAC, original resolution up to 24-bit/192kHz
  LOSSLESS // FLAC 16-bit/44.1kHz
  LOW      // AAC 256kbps, data saver
  MP3      // MP3 320kbps, download only
}

model TrackFile {
  id         String  @id @default(cuid())
  trackId    String
  track      Track   @relation(fields: [trackId], references: [id], onDelete: Cascade)
  quality    Quality
  key        String  // storage key
  mime       String
  bytes      Int
  bitDepth   Int?
  sampleRate Int?

  @@unique([trackId, quality])
}

// An album bought from its artist. The money went to the artist's Stripe
// account; Castalia only records that the buyer may stream and download it.
model Purchase {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  albumId               String
  album                 Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  amountCents           Int      // what the buyer paid the artist
  stripeAccountId       String?  // the artist's account the payment went to
  stripeSessionId       String?  @unique
  stripePaymentIntentId String?  @unique
  createdAt             DateTime @default(now())

  @@unique([userId, albumId])
}

// Plays of 30 seconds or more, as listening statistics for artists.
model Play {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackId  String
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  artistId String
  artist   Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)
  playedAt DateTime @default(now())

  @@index([userId, playedAt])
  @@index([playedAt])
}
