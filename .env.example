# Local Postgres started by `npm run db`
DATABASE_URL="postgresql://castalia:castalia@localhost:5433/castalia"

APP_URL="http://localhost:3000"

# Signs error messages passed in URLs. Set a long random value in production
# (otherwise a random one is made at each start, which is fine locally).
SESSION_SECRET=""

# "Continue with Google" (optional; hidden when empty). Create an OAuth
# client ID of type "Web application" in Google Cloud Console and add
# APP_URL + /api/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Who runs Castalia, for the legal notice, terms and privacy policy. Kept
# here rather than in the code so a home address isn't committed. Use "|"
# between address lines. The pages show [set …] warnings until these are set.
LEGAL_NAME=""
LEGAL_ADDRESS=""   # e.g. "Street 1|1234 AB City|Country"
LEGAL_EMAIL=""
LEGAL_COUNTRY=""   # whose law applies to the terms, e.g. "the Netherlands"

# Email (password resets), sent through Resend (https://resend.com). Without
# these, emails are printed to the dev server's console instead of being
# sent, which only works in development.
RESEND_API_KEY=""
MAIL_FROM=""       # e.g. "Castalia <no-reply@your-domain>", on a domain verified in Resend

# Page where people donate towards running costs (e.g. your Open Collective
# page). Must start with https://. Leave empty to hide donation links.
DONATE_URL=""

# Storage: "local" writes to ./storage. "s3" uses any S3-compatible store
# (Cloudflare R2 recommended: no download/egress fees).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Stripe Connect platform. Buyers pay artists directly on the artists' own
# Stripe accounts; Castalia never holds money. Leave empty for demo mode
# (purchases succeed instantly, no money moves).
STRIPE_SECRET_KEY=""
# Signing secret of the Connect webhook endpoint (events from artists'
# accounts) pointing at /api/stripe/webhook.
STRIPE_CONNECT_WEBHOOK_SECRET=""
# Optional: an account-level webhook endpoint's secret, if you add one.
STRIPE_WEBHOOK_SECRET=""
