# Local Postgres started by `npm run db`
DATABASE_URL="postgresql://castalia:castalia@localhost:5433/castalia"

APP_URL="http://localhost:3000"

# Signs error messages passed in URLs. Set a long random value in production
# (otherwise a random one is made at each start, which is fine locally).
SESSION_SECRET=""

# VAT rate applied to prices (prices are VAT-inclusive). Used when Stripe
# does not report tax itself. 0.21 = Dutch standard rate.
VAT_RATE="0.21"

# Storage: "local" writes to ./storage. "s3" uses any S3-compatible store
# (Cloudflare R2 recommended: no download/egress fees).
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Stripe. Leave empty to run in demo mode: payments are simulated with
# Stripe's standard EU card fee (1.5% + EUR 0.25) and no money moves.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Set to "1" if Stripe Tax is enabled on the account.
STRIPE_TAX="0"
